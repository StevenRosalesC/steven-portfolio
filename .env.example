# ==============================================================================
# STEVEN PORTFOLIO - ENVIRONMENT VARIABLES
# ==============================================================================
# All variables below are OPTIONAL. The portfolio works 100% out-of-the-box
# without configuring any environment variables.

# 1. GitHub API Token (Optional)
# Increases GitHub API rate limits from 60 req/hr to 5,000 req/hr.
# Generate a fine-grained token or classic token with 'public_repo' / read-only access at:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# 2. Production URL (Optional)
# Used for canonical SEO metadata and OpenGraph social preview images
NEXT_PUBLIC_SITE_URL=https://steven-portfolio.vercel.app

# 3. Contact Email (Optional)
# Public contact email address shown across the portfolio
NEXT_PUBLIC_CONTACT_EMAIL=stevenrosales.dev@gmail.com

# 4. Curriculum Vitae (CV) / Resume URL (Optional)
# Public link to your hosted CV/Resume (Google Drive, Dropbox, or hosted PDF)
NEXT_PUBLIC_CV_URL=https://drive.google.com/file/d/120HUgq8Iu5_Ku5tOplqrzQibJa5CT3Wv/view?usp=sharing


